#!/usr/bin/env bash
# merge_pro_pack.sh
# Safely merge the Project-J Pro Pack into your existing repo.
# - Creates backups of any overwritten files in ./backup-<timestamp>/
# - Merges folders like docs/, firebase/, .github/, and src/* pieces
# - Optionally merges package.json scripts if `jq` is installed

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 /path/to/project-j-pro-pack"
  exit 1
fi

SRC="$(cd "$1" && pwd)"
DEST="$(pwd)"
TS="$(date +"%Y%m%d-%H%M%S")"
BACKUP_DIR="$DEST/backup-$TS"

mkdir -p "$BACKUP_DIR"

echo "Source: $SRC"
echo "Dest:   $DEST"
echo "Backup: $BACKUP_DIR"
echo

# --- helpers ---
backup_if_exists() {
  local target="$1"
  if [[ -e "$target" || -L "$target" ]]; then
    local rel="${target#$DEST/}"
    local bdir="$BACKUP_DIR/$(dirname "$rel")"
    mkdir -p "$bdir"
    echo "Backing up $rel -> $bdir/"
    mv "$target" "$bdir/"
  fi
}

copy_file_with_backup() {
  local from="$1"
  local to="$2"
  if [[ -e "$to" || -L "$to" ]]; then
    backup_if_exists "$to"
  fi
  mkdir -p "$(dirname "$to")"
  cp -R "$from" "$to"
  echo "Copied: $(realpath --relative-to="$DEST" "$to")"
}

# --- merge directories ---
merge_dir() {
  local src_dir="$1"
  local dest_dir="$2"
  if [[ ! -d "$src_dir" ]]; then
    echo "Skip (missing): $src_dir"
    return
  fi
  echo "Merging directory: $(realpath --relative-to="$DEST" "$dest_dir")"
  # Use rsync to merge, creating backups in BACKUP_DIR for replaced files
  rsync -a --delete-after --backup --backup-dir="$BACKUP_DIR" "$src_dir"/ "$dest_dir"/ 2>/dev/null || true
}

# Ensure destination subdirs exist before merge
mkdir -p "$DEST/docs" "$DEST/firebase" "$DEST/.github"
mkdir -p "$DEST/src/lib" "$DEST/src/components/ui" "$DEST/src/app/api"

# 1) Merge bulk directories
merge_dir "$SRC/docs" "$DEST/docs"
merge_dir "$SRC/firebase" "$DEST/firebase"
merge_dir "$SRC/.github" "$DEST/.github"

# 2) Merge selective src subfolders
merge_dir "$SRC/src/lib" "$DEST/src/lib"
merge_dir "$SRC/src/components/ui" "$DEST/src/components/ui"

# Ensure summarize dir exists and merge
mkdir -p "$DEST/src/app/api"
if [[ -d "$SRC/src/app/api/summarize" ]]; then
  merge_dir "$SRC/src/app/api/summarize" "$DEST/src/app/api/summarize"
fi

# 3) Copy root files with backup
for f in README.md CONTRIBUTING.md SECURITY.md LICENSE .env.example .editorconfig .prettierrc .eslintrc.json; do
  if [[ -f "$SRC/$f" ]]; then
    copy_file_with_backup "$SRC/$f" "$DEST/$f"
  fi
done

# 4) Handle package.json scripts merge
if [[ -f "$SRC/package.scripts.suggestion.json" ]]; then
  if [[ -f "$DEST/package.json" && -x "$(command -v jq)" ]]; then
    echo "Merging package.json scripts using jq…"
    # Merge scripts: existing + suggestions (suggestions override on conflict)
    tmp_pkg="$DEST/package.json.tmp.$TS"
    jq --slurp '.[0] as $base | .[1] as $sugg | $base * {scripts: ($base.scripts + $sugg.scripts)}' \
      "$DEST/package.json" "$SRC/package.scripts.suggestion.json" > "$tmp_pkg"
    backup_if_exists "$DEST/package.json"
    mv "$tmp_pkg" "$DEST/package.json"
    echo "package.json scripts merged."
  else
    echo "NOTE: Could not auto-merge package.json scripts (jq not available or package.json missing)."
    echo "      A copy of suggestions is saved at ./package.scripts.suggestion.json for manual merge."
    copy_file_with_backup "$SRC/package.scripts.suggestion.json" "$DEST/package.scripts.suggestion.json"
  fi
fi

echo
echo "Done! Review changes with: git status && git diff"
echo "If needed, your backups are in: $BACKUP_DIR"

